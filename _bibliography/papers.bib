@inproceedings{rajesh2026manana,
  abbr        = {NeurIPS},
  bibtex_show = {true},
  selected    = {true},
  title       = {Teaching LLMs to Recommend and Defer in Underrepresented Epilepsy Care},
  author      = {Rajesh, S. and Sharma, K. and Monsoor, T. and Turali, M. Y. and Idro, R. and Kayaga, J. and Sebunya, R. and Namata, T. T. and Pasqua, J. N. and Roychowdhury, V. and Mazumder, R.},
  booktitle   = {Advances in Neural Information Processing Systems (NeurIPS)},
  year        = {2026},
  note        = {*Equal contribution by Rajesh and Sharma.},
  arxiv       = {2606.31036},
  code        = {https://github.com/roychowdhuryresearch/Manana},
  abstract    = {LLM-based decision support for anti-seizure medication management in Ugandan pediatric epilepsy care must adapt to local prescribing practice and know when to defer. MANANA is a non-parametric prompt-learning framework, with single- and multi-agent variants, that converts observed prescription errors into auditable prompt memories learned from a small patient-level training set. Bayesian prompt averaging turns the learned prompt trajectory into prescription likelihoods and an uncertainty-based deferral signal: on an independently collected held-out cohort, it improves visit-level top-3 prescription accuracy by 4-8 percentage points over prompt-optimization baselines and auto-handles the most confident half of cases at 95% precision while deferring the rest for specialist review.}
}

@inproceedings{rajesh2026panini,
  abbr        = {ICML},
  bibtex_show = {true},
  selected    = {true},
  title       = {Panini: Continual Learning in Token Space via Structured Memory},
  author      = {Rajesh, S. and Holur, P. S. and Turali, M. Y. and Duan, C. and Roychowdhury, V.},
  booktitle   = {Proceedings of the 43rd International Conference on Machine Learning (ICML)},
  year        = {2026},
  note        = {Accepted as poster. *Equal contribution by Rajesh and Holur.},
  abstract    = {PANINI is a non-parametric continual-learning framework that encodes documents into Generative Semantic Workspaces (GSW)—entity- and event-aware networks of atomic question-answer pairs. A beam-search retrieval procedure (Reasoning Inference Chain Retrieval, RICR) follows multi-hop inference chains through GSWs to assemble compact evidence, achieving top average performance across six QA benchmarks while using 2-30x fewer answer-context tokens than competitive baselines.}
}

@inproceedings{mccrimmon2026organoid,
  abbr        = {ICASSP},
  bibtex_show = {true},
  title       = {Time-Resolved Neuronal Network Dynamics Distinguish Pathological States in Organoid Models},
  author      = {McCrimmon, C. M. and Sinha, P. and Cao, Q. and Monsoor, T. and Sharma, K. and Turali, M. Y. and Samarasinghe, R. A. and Roychowdhury, V.},
  booktitle   = {2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)},
  pages       = {7787--7791},
  year        = {2026},
  doi         = {10.1109/ICASSP55912.2026.11461496},
  html        = {https://doi.org/10.1109/ICASSP55912.2026.11461496},
  abstract    = {Human brain assembloids offer a powerful platform for modeling neurological diseases, yet comprehensive methods for analyzing their complex network dynamics are lacking. We develop a time-resolved network analysis pipeline that extracts quantitative biomarkers from two-photon calcium imaging and apply it to assembloids carrying a pathogenic MAPT p.R406W variant, clinically associated with an Alzheimer's disease-like phenotype, and their isogenic controls. Mutant networks exhibit significantly increased degree variance and clustering, a hub-like topology prone to hypersynchrony, and a Random Forest classifier trained on the dynamic network features distinguishes diseased from control states with an F1 score of 0.90.}
}

